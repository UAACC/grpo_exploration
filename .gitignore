# Ignore everything by default
*

# Track these folders
!mixture_grpo/
!offline_grpo/
!online_grpo/
!DG-offline/
!dr_mixture_grpo/
!bc/
!Math_Verifier/
!RWR-offline/
!AWR-offline/

# Track root-level supporting files
!README.md
!docs/
docs/*
!docs/progress_reports/
!docs/progress_reports/**
!run_eval_all.sh
!setup_downloads.sh
!.gitignore
!requirements.txt

# Within tracked folders, include all code recursively
!mixture_grpo/**
!offline_grpo/**
!online_grpo/**
!DG-offline/**
!dr_mixture_grpo/**
!bc/**
!shared/
!shared/**
!Math_Verifier/**
!RWR-offline/**
!AWR-offline/**
!SoftDG-Offline-to-the-bottom/**
# But exclude runtime artifacts everywhere
**/__pycache__/
**/*.pyc
**/logs/
**/wandb/
**/.wandb_key
**/outputs/
**/.claude/

# Exclude large data files
*.jsonl
*.tar.gz
*.bin
*.safetensors
*.pt
*.pth

# Exclude env/IDE
.venv/
*.egg-info/
